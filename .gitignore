# ===============================

# Backend .gitignore (Node.js)

# ===============================

# Dependencies

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables

.env
.env.*
!.env.example

# Build output

dist/
build/

# Logs

logs/
*.log

# Coverage

coverage/

# Cache

.cache/
.eslintcache

# OS files

.DS_Store
Thumbs.db

# Editor / IDE

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Database files

*.sqlite
*.db

# Uploads / storage

# uploads/
public/uploads/

# Temp files

tmp/
temp/

# Process managers

.pm2/
pids/
*.pid

# Docker

.dockerignore

# Backup / swap files

*.bak
*.swp
